CC = clang
CFLAGS = -O2 -Iinclude
LDFLAGS = -lm

SRC_DIR = src
BUILD_DIR = build

SOURCES = $(SRC_DIR)/value.c $(SRC_DIR)/lexer.c $(SRC_DIR)/interpreter.c \
          $(SRC_DIR)/parser.c $(SRC_DIR)/builtin.c $(SRC_DIR)/main.c
OBJECTS = $(SOURCES:$(SRC_DIR)/%.c=$(BUILD_DIR)/%.o)

TARGET = myrun

.PHONY: all clean debug

all: $(TARGET)

$(TARGET): $(OBJECTS)
	$(CC) $(OBJECTS) -o $(TARGET) $(LDFLAGS)

$(BUILD_DIR)/%.o: $(SRC_DIR)/%.c | $(BUILD_DIR)
	$(CC) $(CFLAGS) -c $< -o $@

$(BUILD_DIR):
	mkdir -p $(BUILD_DIR)

# Build dengan AddressSanitizer, untuk mencari bug memori saat
# mengembangkan fitur baru. Pakai: make debug
debug: CFLAGS += -g -fsanitize=address -fno-omit-frame-pointer
debug: LDFLAGS += -fsanitize=address
debug: clean $(TARGET)

clean:
	rm -rf $(BUILD_DIR) $(TARGET)
